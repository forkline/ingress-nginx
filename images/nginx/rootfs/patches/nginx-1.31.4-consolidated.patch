+    if (ngx_http_parse_set_cookie_lines(r, r->upstream->headers_in.set_cookie,
+                                        &s, &cookie)
+        == NULL)
+    {
+        v->not_found = 1;
+        return NGX_OK;
+    }
+
+    v->len = cookie.len;
+    v->valid = 1;
+    v->no_cacheable = 0;
+    v->not_found = 0;
+    v->data = cookie.data;
+
+    return NGX_OK;
+}
