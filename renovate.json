{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "separateMajorMinor": false,
  "configMigration": true,
  "forkProcessing": "enabled",
  "dependencyDashboard": true,
  "labels": ["area/dependency"],
  "commitMessagePrefix": "build(deps): ",
  "branchPrefix": "renovate/",
  "pre-commit": {
    "enabled": true,
    "commitMessagePrefix": "chore(pre-commit): ",
    "branchPrefix": "pre-commit-"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track inline renovate hints in workflow and config files",
      "managerFilePatterns": ["/.+\\.ya?ml$/", "/(^|/)Makefile$/", "/images/nginx/rootfs/build\\.sh$/"],
      "matchStrings": [
        "#\\srenovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?( versioning=(?<versioning>\\S+))?\\n.*?: (?<currentValue>.*)\\n",
        "#\\srenovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?( versioning=(?<versioning>\\S+))?\\n.*?=\\s*(?<currentValue>.*)\\n"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Track NGINX_BASE with the same nginx/nginx release dependency as build.sh",
      "managerFilePatterns": [
        "/^NGINX_BASE$/"
      ],
      "matchStrings": [
        "ghcr\\.io/forkline/ingress-nginx/nginx:(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "nginx/nginx",
      "extractVersionTemplate": "^release-(?<version>.*)$",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Known-bad updates: non-semver tag (helm-docs 19.0614), +incompatible version (client-go v11), unsupported major (yaml v4)",
      "matchPackageNames": ["norwoodj/helm-docs", "/helm-docs/"],
      "allowedVersions": "!/^v?19\\./"
    },
    {
      "matchPackageNames": ["k8s.io/client-go"],
      "allowedVersions": "/^v0\\./"
    },
    {
      "matchPackageNames": ["go.yaml.in/yaml/v3"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["nginx"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "go modules",
      "groupSlug": "go-modules"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "groupSlug": "github-actions"
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "docker images",
      "groupSlug": "docker-images"
    },
    {
      "matchPackageNames": ["kindest/node"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "versioning": "loose",
      "matchPackageNames": ["/debian/"]
    },
    {
      "matchPackageNames": ["google.golang.org/grpc/examples"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "ignoreTests": false
    },
    {
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "nginx/nginx"
      ],
      "groupName": "NGINX source",
      "groupSlug": "nginx-source"
    },
    {
      "description": "Update renovate pre-commit hook once a month and automerge",
      "matchPackageNames": ["renovatebot/pre-commit-hooks"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "ignoreTests": false,
      "schedule": ["after 4am and before 10am on the first day of the month"]
    },
    {
      "description": "Automerge is opt-in per low-risk lane; the lanes mirror the merge-gate skill. Pre-commit hook patch and minor updates",
      "matchManagers": ["pre-commit"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "ignoreTests": false
    },
    {
      "description": "Go modules patch and minor: Renovate itself merges and waits for every check, not only the required ones (a Helm failure merged in #506)",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "ignoreTests": false
    },
    {
      "description": "Docs and tooling files only",
      "matchFileNames": ["hack/.tool-versions", "docs/requirements.txt", ".github/actions/mkdocs/Dockerfile"],
      "matchUpdateTypes": ["patch", "minor", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "ignoreTests": false
    },
    {
      "description": "Never automerge: majors, GitHub Actions and workflow tool pins (not low risk, #506 and #622), NGINX, the Go toolchain. A maintainer or the merge-gate routine decides",
      "matchPackageNames": ["!google.golang.org/grpc/examples"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchManagers": ["github-actions", "custom.regex"],
      "matchFileNames": [".github/workflows/**"],
      "automerge": false
    },
    {
      "matchPackageNames": ["nginx/nginx", "ghcr.io/forkline/ingress-nginx/nginx", "go", "golang"],
      "automerge": false
    }
  ]
}
